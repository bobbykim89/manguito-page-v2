# Fake, non-secret values used only by the tests (the API build and the unit
# environment). The test server overrides the database URI at runtime
# (NUXT_MONGO_URI), so these never reach a real service.
WORK_BRANCH=TEST
MONGO_ADMIN_ID=test-user
MONGO_ADMIN_PW=test-password
MONGO_CLUSTER_NAME=test-cluster
MONGO_DB_NAME=manguito-page-test
MONGO_URL=test
JWT_SECRET=test-secret
ADMIN_SECRET_PHRASE=test-admin-phrase
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=test-cloudinary-secret
CLOUDINARY_FOLDER=test
CLOUDINARY_SOURCE_URL=https://res.cloudinary.test/
MAILER_EMAIL_ADDRESS=mailer@example.test
MAILER_APP_PASSWORD=test-mailer-password
