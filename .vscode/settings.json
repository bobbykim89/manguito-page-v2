{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.ts": "typescript"
  },
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 100,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "prettier.singleQuote": true,
  "prettier.semi": false,
  "peacock.color": "#F07C8A",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#f5aab3",
    "activityBar.background": "#f5aab3",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#208f11",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#f5aab3",
    "statusBar.background": "#f07c8a",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#eb4e61",
    "statusBarItem.remoteBackground": "#b2f5a9",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#f07c8a",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#f07c8a99",
    "titleBar.inactiveForeground": "#15202b99",
    "activityBar.activeBorder": "#15202b",
    "activityBarTop.activeBackground": "#f5aab3",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#f5aab3",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "statusBar.debuggingBackground": "#f07c8a",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.inactiveBackground": "#f07c8a"
  }
}
