{
  "name": "manguito-page-v2",
  "version": "0.1.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "db:local:rm": "docker compose rm local-db -s -f -v",
    "db:local:up": "docker compose up local-db -d",
    "db:local:restart": "pnpm db:local:rm && pnpm db:local:up",
    "build": "nuxt build",
    "build:local": "nuxt build --dotenv .env.local",
    "build:dev": "nuxt build --dotenv .env.dev",
    "build:prod": "nuxt build --dotenv .env",
    "dev": "nuxt dev --dotenv .env.local",
    "dev:dev": "nuxt dev --dotenv .env.dev",
    "dev:prod": "nuxt dev --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bobbykim/manguito-theme": "1.6.0",
    "@bobbykim/mcl-cards": "0.10.9",
    "@bobbykim/mcl-container": "0.9.8",
    "@bobbykim/mcl-footer": "0.10.9",
    "@bobbykim/mcl-forms": "0.13.0",
    "@nuxt/fonts": "0.13.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/robots": "^5.7.0",
    "@pinia/nuxt": "0.11.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@vueuse/core": "14.2.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.6",
    "nodemailer": "^8.0.0",
    "nuxt": "4.3.0",
    "pinia": "3.0.4",
    "postcss": "^8.5.6",
    "vue": "3.5.27",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "4.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.1",
    "@types/nodemailer": "^7.0.9",
    "@vite-pwa/nuxt": "1.1.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "get-port-please": "^3.2.0",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "7.3.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.2.4"
  }
}
